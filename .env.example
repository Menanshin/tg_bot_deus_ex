# === Telegram Bot Config ===
TELEGRAM_TOKEN=your_telegram_bot_token_here
OWNER_ID=123456789
# Тайное слово врат: то же значение передаётся в setWebhook как secret_token.
# Пусто — проверка заголовка отключена.
WEBHOOK_SECRET=change_me

# === OpenAI API ===
OPENAI_API_KEY=your_openai_api_key_here
# Духи по умолчанию; можно не задавать.
# MODEL_DEFAULT=gpt-4o-mini
# MODEL_PREMIUM=gpt-4o

# === Хроники ===
# Куда класть state.json. В контейнере — /data (см. Dockerfile).
# STATE_DIR=.
